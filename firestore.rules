rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    match /test/connection {
      allow read: if true;
    }

    match /users/{userDocId} {
      allow read, write: if isSignedIn();

      match /{subcollection=**} {
        allow read, write: if isSignedIn();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
